<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:useController="false" />

    <!-- Performance HUD & Diagnostic Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#99000000"
        android:padding="16dp"
        android:layout_gravity="top">

        <TextView
            android:id="@+id/tvCodecInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Codec: Evaluating..."
            android:textColor="#10b981"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMetrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TTFF: -- ms | Decoder Init: -- ms | Dropped: 0"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvPolicyReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Policy: Initializing"
            android:textColor="#94a3b8"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <Button
            android:id="@+id/btnForceError"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="⚡ Force Decoder Failure (Test Fallback)"
            android:textSize="11sp"
            android:background="#dc2626"
            android:textColor="#ffffff"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</FrameLayout>
